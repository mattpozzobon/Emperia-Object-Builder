<?xml version="1.0" encoding="utf-8"?>
<s:Skin xmlns:fx="http://ns.adobe.com/mxml/2009"
    xmlns:s="library://ns.adobe.com/flex/spark"
    alpha.disabled="0.5"
    minWidth="0" minHeight="0">

    <s:states>
        <s:State name="normal"/>
        <s:State name="disabled"/>
    </s:states>

    <!-- outer border -->
    <s:Rect left="0" right="0" top="0" bottom="0">
        <s:fill>
            <s:SolidColor color="0x000000"/>
        </s:fill>
        <s:stroke>
            <s:SolidColorStroke color="0x272727"/>
        </s:stroke>
    </s:Rect>

    <!-- header bar -->
    <s:Rect left="1" right="1" top="1" height="20">
        <s:fill>
            <s:SolidColor color="0x111111"/>
        </s:fill>
    </s:Rect>

    <!-- header separator -->
    <s:Line left="1" right="1" top="21">
        <s:stroke>
            <s:SolidColorStroke color="0x272727"/>
        </s:stroke>
    </s:Line>

    <!-- label -->
    <s:Label id="labelDisplay"
        left="8"
        top="3"
        fontSize="11"
        color="0xCBCBCB"/>

    <!-- content -->
    <s:Group id="contentGroup"
        left="1" right="1" top="22" bottom="1"
        minWidth="0" minHeight="0"/>
</s:Skin>
